     ]
    }
   ],
   "source": [
    "# 언패킹 사용하기 \n",
    "# 리스트나 튜플에 *(아스트리크)를 붙여 함수를 호출할 수 있다.\n",
    "# 함수(*리스트)\n",
    "# 함수(*튜플)\n",
    "x = [10, 20, 30]\n",
    "print_numbers(*x)\n",
    "print_numbers(*[10, 20, 30])"
   ]
  },
